# REEDS EC2 worker environment template.
# Fill in real values and EXPORT them (or place at /etc/reeds.env and use as
# the systemd EnvironmentFile). NEVER commit real values to the repository.
#
#   export DATABASE_URL='postgresql://...'          # Neon production DB
#   export ADMIN_API_KEY='...'                      # matches Render's ADMIN_API_KEY
#   export RENDER_URL='https://reeds-phj1.onrender.com'
#   export MODEL_DIR='/home/ubuntu/REEDS/backend/data/models'
#   export MIN_TRAINING_ROWS='200'
#   # export SPORTS_OVERRIDE='soccer,basketball'    # optional run-all subset

DATABASE_URL=
ADMIN_API_KEY=
RENDER_URL=https://reeds-phj1.onrender.com
MODEL_DIR=/home/ubuntu/REEDS/backend/data/models
MIN_TRAINING_ROWS=200
# SPORTS_OVERRIDE=