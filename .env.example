# LOYAL EDGE - Environment Configuration
# Copy this to .env and fill in your values

# === Database ===
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require&channel_binding=require"

# === API Keys ===
# Admin API key for accessing /api/admin/* endpoints
ADMIN_API_KEY=23235567Jjmt.

# API-Football (api-sports.io) - v3.football.api-sports.io
API_FOOTBALL_KEY=
# Alternative API Football (apifootball.com)
API_FOOTBALL_COM_KEY=
# API-SPORTS master key (works for football + basketball)
API_SPORTS_KEY=
# API-Basketball (api-sports.io) - v1.basketball.api-sports.io
API_BASKETBALL_KEY=

# === Odds API ===
THE_ODDS_API_KEY=
# All sports: soccer + NBA, NFL, NHL, MLB, tennis — odds refresh every 15 min including live games
THE_ODDS_API_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_fifa_world_cup_qualifier,soccer_uefa_european_championship_qualifier,soccer_conmebol_world_cup_qualifier,soccer_concacaf_world_cup_qualifier,soccer_afc_asian_cup_qualifier,soccer_caf_africa_cup_of_nations_qualifier,soccer_international_friendly,basketball_nba,basketball_euroleague,americanfootball_nfl,baseball_mlb,icehockey_nhl,tennis_atp_us_open,tennis_wta_us_open

# === Other Sports APIs ===
SPORTMONKS_API_KEY=
FOOTBALL_DATA_API_KEY=
ALLSPORTSAPI_KEY=
ALLSPORTSAPI_SPORTS=football,basketball,tennis,cricket,hockey,baseball,american-football,volleyball,handball

# === TheSportsDB ===
THESPORTSDB_ENABLED=true
THESPORTSDB_API_KEY=3
THESPORTSDB_SPORTS=Soccer,Basketball,American Football,Cricket,Tennis,Ice Hockey,Baseball,Rugby,Motorsport,Fighting
THESPORTSDB_MAX_CALLS=50

# === App Configuration ===
APP_ENV=production
ENABLE_SCHEDULER=true
CORS_ORIGINS=https://reeds-phi.vercel.app,http://localhost:3000
LIVE_INGEST_DAYS=7
MIN_TRAINING_ROWS=20
MODEL_DIR=data/models
PUBLIC_BRAND_NAME=LOYAL EDGE